# Application
APP_ENV=production
PORT=4000

# Domain (for Caddy)
DOMAIN=yourdomain.com

# MongoDB Configuration
# Format: mongodb://username:password@host:port
MONGODB_URL=mongodb://admin:your_secure_password_here@mongo:27017
MONGODB_DATABASE=trakrlog
MONGODB_PASSWORD=your_secure_password_here

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here_generate_with_openssl_rand_hex_32

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://yourdomain.com/auth/github/callback
